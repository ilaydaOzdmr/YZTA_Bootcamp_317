# ResilienceOS - ortam degiskenleri ornegi
# Bu dosyayi ".env" olarak kopyala ve anahtarlari doldur. .env'i GIT'e EKLEME.

# --- TCMB EVDS (makro veri) ---
# https://evds3.tcmb.gov.tr -> ucretsiz hesap -> Profil -> "API Key Kopyala"
EVDS_API_KEY=

# --- Kaggle (gercek veri setleri) ---
# kaggle.com -> Settings -> "Create New API Token" -> kaggle.json
# Tercih 1: kaggle.json dosyasini ~/.kaggle/kaggle.json konumuna koy (asagidakileri bos birak)
# Tercih 2: asagiya elle gir
KAGGLE_USERNAME=
KAGGLE_KEY=
